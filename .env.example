# --- PostgreSQL ---
POSTGRES_USER=futurekawa
POSTGRES_PASSWORD=futurekawa
POSTGRES_DB=futurekawa_local

# URL pour un développement local hors conteneur (uvicorn sur l'hôte)
# À l'intérieur de compose, l'API utilise postgres:5432 automatiquement.
DATABASE_URL=postgresql+psycopg2://futurekawa:futurekawa@localhost:5432/futurekawa_local

# Clé API partagée avec le backend central (en-tête X-API-Key)
API_KEY=change-me

# Fréquence de vérification des lots trop anciens (> 365 jours), en secondes.
# Par défaut : toutes les 3600 s (1 h). Une passe est aussi effectuée au démarrage.
ALERTE_LOTS_INTERVAL_SECONDS=3600

# Envoi des alertes e-mail via Brevo (smtp-relay.brevo.com, port 587, STARTTLS).
# Le login exige la clé SMTP Brevo (xsmtpsib-...) comme identifiant ET mot de passe.
# SMTP_FROM doit être un expéditeur vérifié dans Brevo, sinon l'envoi échoue (503).
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@futurekawa.com
