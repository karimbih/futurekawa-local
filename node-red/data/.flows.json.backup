    {
        "id": "52d63aa1d71c32b4",
        "type": "function",
        "z": "367cf04d344f352a",
        "name": "Vers API Local",
        "func": "let data = msg.payload;\n\n// MQTT data is often a string\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (error) {\n        node.error(\"Invalid MQTT JSON: \" + error.message, msg);\n        return null;\n    }\n}\n\n// Prepare exactly the payload required by POST /mesures/.\nmsg.payload = {\n    topic_mqtt: msg.topic,\n    temperature_c: Number(data.temperature),\n    humidite_pct: Number(data.humidity),\n    date_mesure: new Date().toISOString()\n};\n\n// Change the host only if Node-RED cannot reach the local API this way.\nmsg.url = \"http://host.docker.internal:8000/mesures/\";\nmsg.method = \"POST\";\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\",\n    \"X-API-Key\": \"CDWRggjsE0FCH4Zjx3AVfTL2PdHsJN06\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 520,
        "wires": [
            [
                "344952e3540f6295"
            ]
        ]
    },
